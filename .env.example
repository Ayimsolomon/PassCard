# GEMINI_API_KEY: Required for Gemini API / Gemma 4 cloud calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PROVIDER: Select 'api' (Google AI Studio Gemma 4) or 'local' (Ollama)
PROVIDER="api"

# Gemma 4 Cloud Model ID (tested & verified: gemma-4-26b-a4b-it)
GEMMA_MODEL="gemma-4-26b-a4b-it"

# Ollama local settings (used when PROVIDER="local")
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="gemma4:e2b"

# Secret key used to generate tamper-proof digital stamps on pass cards
PASS_SIGNING_SECRET="gemma4-onboarding-secret-key"

# Live Email Delivery (Optional: configure SMTP to send real emails to inboxes)
# e.g., Gmail App Password, SendGrid, Mailgun, Amazon SES, or Brevo
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Nexus Passcards <your-email@gmail.com>"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
